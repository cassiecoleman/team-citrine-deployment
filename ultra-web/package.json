{
  "name": "ultra-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:driver-trips": "vitest run --config vitest.backend.config.mts src/features/driver-trips/__tests__/driver-trip-operations.test.ts",
    "test:driver-trips:coverage": "vitest run --config vitest.backend.config.mts src/features/driver-trips/__tests__/driver-trip-operations.test.ts --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:types": "npx supabase gen types typescript --project-id mcxgvblnfuedzlojspba > src/types/supabase.ts",
    "db:push": "npx supabase db push",
    "db:migration:new": "npx supabase migration new",
    "demo:clear-pending": "npx tsx scripts/clear-pending-rides.ts",
    "demo:clear-incomplete": "npx tsx scripts/clear-incomplete-rides.ts",
    "demo:live-map": "npx tsx scripts/demo-live-map.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
